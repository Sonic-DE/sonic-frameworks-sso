prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@
plugin_includedir=${includedir}/signon-plugins/SignOn

Name: signon-plugins-common
Description: SignOn plugin IPC support
Version: @PROJECT_VERSION@
Requires: signon-plugins Qt6DBus
Libs: -L${libdir} -lsignon-plugins-common
Cflags: -I${includedir}/signon-plugins -I${plugin_includedir}
